# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
**/build/

# Flutter platform-generated files
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh
**/Flutter/ephemeral/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated files
*.g.dart
*.freezed.dart
*.config.dart

# Generated Dart sources are committed so a fresh clone can run immediately.
!lib/**/*.g.dart
!lib/**/*.freezed.dart

# Hive
*.hive

# Keep the application dependency lockfile; platform dependency lockfiles stay local.
*.lock
!pubspec.lock

# Large native framework is rebuilt from upstream libXray.
ios/Frameworks/LibXray.xcframework/

# Duplicate archive of the bundled macOS Xray executable.
xray-core/xray.zip
